generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TipoUsuario {
  ALUNO
  EMPRESA
  ADMIN
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  senha     String
  tipo      TipoUsuario @default(ALUNO)
  situacao  String?     @default("ATIVO")
  createdAt DateTime    @default(now())
}